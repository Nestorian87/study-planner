  "pages": {
    "hub": {
      "title": "Навчання · шаблон",
      "icon": "🌿",
      "content": "# Цей тиждень\n\n# Роботи\n\n# Здачі"
    },
    "settings": {
      "title": "Налаштування",
      "icon": "⚙️",
      "content": "| Параметр | Значення |\n| --- | --- |\n| Кінець семестру | Не вказано |\n| Доступно годин на тиждень | Не вказано |\n| Резерв | 20% |\n| Група | Не вказано |\n| Часовий пояс | Europe/Kyiv |\n\nЗусилля предмета: невідомо / мінімальні / помірні / значні. Це особиста участь, не години роботи агентів."
    }
  },
  "views": [
    {
      "source": "courses",
      "name": "Предмети",
      "type": "gallery",
      "configure": "FILTER \"Архів\" = FALSE; SHOW \"Назва\", \"Ваші зусилля\"; CARD SIZE small"
    },
    {
      "source": "tasks",
      "name": "Роботи",
      "type": "table",
      "configure": "FILTER \"Архів\" = FALSE; GROUP BY \"Предмет\" HIDE EMPTY; SHOW \"Назва\", \"Стан\", \"Формат роботи\", \"Дедлайн\"; QUICK FILTER \"Предмет\", \"Стан\"; WIDTH \"Назва\" 300"
    },
    {
      "source": "tasks",
      "name": "Фокус тижня",
      "type": "table",
      "configure": "FILTER \"Тиждень фокусу\" <= \"today\" AND \"Кінець фокусу\" >= \"today\" AND \"Архів\" = FALSE AND \"Стан\" != \"Зарахована\"; SHOW \"Назва\", \"Стан\", \"Наступний крок\", \"Чому зараз\"; SORT BY \"Пріоритет\" ASC"
    },
    {
      "source": "tasks",
      "name": "Готове до здачі",
      "type": "list",
      "configure": "FILTER \"Стан\" = \"Готова до здачі\" AND \"Архів\" = FALSE; SHOW \"Назва\", \"Предмет\""
    },
    {
      "source": "tasks",
      "name": "Поступ",
      "type": "board",
      "configure": "FILTER \"Архів\" = FALSE; GROUP BY \"Стан\" BY OPTION SHOW EMPTY; SHOW \"Назва\", \"Предмет\"; CARD LAYOUT compact"
    },
    {
      "source": "opportunities",
      "name": "Можливості здачі",
      "type": "table",
      "configure": "FILTER \"Стан\" = \"Майбутня\"; SHOW \"Назва\", \"Коли\", \"Предмет\", \"Підтвердження\", \"Група\"; SORT BY \"Коли\" ASC"
    },
    {
      "source": "plans",
      "name": "Поточний план",
      "type": "gallery",
      "configure": "FILTER \"Стан\" IN (\"Актуальний\", \"Потребує перегляду\") AND \"Тиждень\" <= \"today\" AND \"Кінець тижня\" >= \"today\"; SHOW \"Назва\", \"Тиждень\", \"Доступно год\", \"Стан\"; CARD SIZE small"
    }
  ]
}
